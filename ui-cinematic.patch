+import SwiftUI
+import HealthCore
+
+/// Chronological local timeline. It combines real HealthKit samples with
+/// explicit user records and keeps the source visible for every entry.
+struct HealthTimelineView: View {
+    @EnvironmentObject private var health: HealthViewModel
+    @EnvironmentObject private var journal: JournalStore
+    @StateObject private var nutrition = NutritionStore()
+
+    fileprivate struct Event: Identifiable {
+        let id: String
+        let date: Date
+        let title: String
+        let detail: String
+        let source: String
+        let icon: String
+        let color: Color
+    }
+
+    private var events: [Event] {
+        let cutoff = Date().addingTimeInterval(-36 * 3600)
+        var result: [Event] = []
+
+        for (id, reading) in health.readings where reading.recordedAt >= cutoff {
+            guard let metric = HealthCatalog.byID[id] else { continue }
+            result.append(
+                Event(
+                    id: "health-\(id)-\(reading.recordedAt.timeIntervalSince1970)",
+                    date: reading.recordedAt,
+                    title: metric.name,
+                    detail: "\(metric.display(reading.value)) \(metric.unitText)",
+                    source: reading.source.isEmpty ? "来源未知" : reading.source,
+                    icon: metric.symbol,
+                    color: HealthTheme.v3Stress
+                )
+            )
