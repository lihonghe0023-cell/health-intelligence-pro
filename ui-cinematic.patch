diff --git a/iOS/Services/NutritionStore.swift b/iOS/Services/NutritionStore.swift
new file mode 100644
index 0000000..f848b9a
--- /dev/null
+++ b/iOS/Services/NutritionStore.swift
@@ -0,0 +1,160 @@
+import Foundation
+import Combine
+
+struct NutritionEntry: Codable, Identifiable, Sendable {
+    let id: UUID
+    let timestamp: Date
+    let title: String
+    let calories: Double
+    let protein: Double
+    let carbohydrates: Double
+    let fat: Double
+    let fiber: Double
+    let water: Double
+    let caffeine: Double
+
+    init(
+        id: UUID = UUID(),
+        timestamp: Date = Date(),
+        title: String,
+        calories: Double,
+        protein: Double,
+        carbohydrates: Double,
+        fat: Double,
+        fiber: Double,
+        water: Double,
+        caffeine: Double
+    ) {
+        self.id = id
+        self.timestamp = timestamp
+        self.title = title
+        self.calories = calories
+        self.protein = protein
+        self.carbohydrates = carbohydrates
+        self.fat = fat
+        self.fiber = fiber
+        self.water = water
+        self.caffeine = caffeine
+    }
+}
+
+struct DailyNutritionSummary {
+    let calories: Double
+    let protein: Double
+    let carbohydrates: Double
+    let fat: Double
+    let fiber: Double
+    let water: Double
+    let caffeine: Double
+
+    var macroCalories: Double {
+        (protein * 4) + (carbohydrates * 4) + (fat * 9)
+    }
+
+    var proteinShare: Double {
+        guard macroCalories > 0 else { return 0 }
+        return protein * 4 / macroCalories
+    }
+
+    var carbohydrateShare: Double {
+        guard macroCalories > 0 else { return 0 }
+        return carbohydrates * 4 / macroCalories
+    }
+
+    var fatShare: Double {
+        guard macroCalories > 0 else { return 0 }
+        return fat * 9 / macroCalories
+    }
+}
+
+@MainActor
+final class NutritionStore: ObservableObject {
+    @Published private(set) var entries: [NutritionEntry] = []
+    @Published var errorMessage: String?
+
+    private var fileURL: URL {
+        FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("PrivateNutrition", isDirectory: true)
+            .appendingPathComponent("entries.json")
+    }
+
+    init() { load() }
+
+    func add(
+        title: String,
+        calories: Double,
+        protein: Double,
+        carbohydrates: Double,
+        fat: Double,
+        fiber: Double,
+        water: Double,
+        caffeine: Double
+    ) -> Bool {
+        let trimmed = title.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { return false }
+        entries.insert(
+            NutritionEntry(
+                title: trimmed,
+                calories: max(calories, 0),
+                protein: max(protein, 0),
+                carbohydrates: max(carbohydrates, 0),
+                fat: max(fat, 0),
+                fiber: max(fiber, 0),
+                water: max(water, 0),
+                caffeine: max(caffeine, 0)
+            ),
+            at: 0
+        )
+        return persist()
+    }
+
+    func remove(at offsets: IndexSet) {
+        for index in offsets.sorted(by: >) { entries.remove(at: index) }
+        _ = persist()
+    }
+
+    func remove(id: UUID) {
+        entries.removeAll { $0.id == id }
+        _ = persist()
+    }
+
+    func todaySummary(calendar: Calendar = .current, now: Date = .now) -> DailyNutritionSummary {
+        let today = entries.filter { calendar.isDate($0.timestamp, inSameDayAs: now) }
+        return DailyNutritionSummary(
+            calories: today.reduce(0) { $0 + $1.calories },
+            protein: today.reduce(0) { $0 + $1.protein },
+            carbohydrates: today.reduce(0) { $0 + $1.carbohydrates },
+            fat: today.reduce(0) { $0 + $1.fat },
+            fiber: today.reduce(0) { $0 + $1.fiber },
+            water: today.reduce(0) { $0 + $1.water },
+            caffeine: today.reduce(0) { $0 + $1.caffeine }
+        )
+    }
+
+    private func load() {
+        guard FileManager.default.fileExists(atPath: fileURL.path) else { return }
+        do {
+            entries = try JSONDecoder().decode([NutritionEntry].self, from: Data(contentsOf: fileURL))
+        } catch {
+            errorMessage = "本地营养记录读取失败：\(error.localizedDescription)"
+        }
+    }
+
+    @discardableResult
+    private func persist() -> Bool {
+        do {
+            try FileManager.default.createDirectory(
+                at: fileURL.deletingLastPathComponent(),
+                withIntermediateDirectories: true
+            )
+            let encoder = JSONEncoder()
+            encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+            try encoder.encode(entries).write(to: fileURL, options: [.atomic, .completeFileProtection])
+            errorMessage = nil
+            return true
+        } catch {
+            errorMessage = "本地营养记录保存失败：\(error.localizedDescription)"
+            return false
+        }
+    }
+}
